// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String?
  avatar    String?
  githubId  String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects Project[]
  reviews  Review[]
  comments ReviewComment[]
  chatMessages ChatMessage[]

  @@map("users")
}

model Project {
  id            String   @id @default(uuid())
  name          String
  description   String?
  repositoryUrl String?
  localPath     String?
  userId        String
  status        ProjectStatus @default(PENDING)
  fileCount     Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysisResults  AnalysisResult[]
  reviews          Review[]
  chatMessages     ChatMessage[]

  @@map("projects")
}

enum ProjectStatus {
  PENDING
  ANALYZING
  COMPLETED
  FAILED
}

model AnalysisResult {
  id        String   @id @default(uuid())
  projectId String
  filePath  String
  language  String
  issues    Json     // CodeIssue[]
  suggestions Json   // CodeSuggestion[]
  metrics   Json     // CodeMetrics
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("analysis_results")
}

model Review {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  status    ReviewStatus @default(IN_PROGRESS)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project  Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments ReviewComment[]

  @@map("reviews")
}

enum ReviewStatus {
  IN_PROGRESS
  COMPLETED
}

model ReviewComment {
  id        String   @id @default(uuid())
  reviewId  String
  userId    String
  filePath  String
  line      Int
  content   String   @db.Text
  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("review_comments")
}

model ChatMessage {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  role      MessageRole
  content   String   @db.Text
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

enum MessageRole {
  USER
  ASSISTANT
}
