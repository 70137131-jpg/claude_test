# Flask Backend Environment Variables

# Server
FLASK_APP=app.py
FLASK_ENV=development
PORT=5000
SECRET_KEY=your-secret-key-change-in-production

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/code_review_db

# Redis (for Celery)
REDIS_URL=redis://localhost:6379

# AI (REQUIRED for Vercel)
ANTHROPIC_API_KEY=your-anthropic-api-key

# GitHub OAuth (optional)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# CORS (REQUIRED for Vercel - update with your frontend URL)
CORS_ORIGIN=http://localhost:5173

# File Storage
UPLOAD_DIR=./uploads

# ===== VERCEL PRODUCTION SETTINGS =====
# When deploying to Vercel, set these environment variables:
#
# FLASK_ENV=production
# SECRET_KEY=<generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))">
# DATABASE_URL=<your Vercel Postgres, Supabase, or Neon connection string>
# ANTHROPIC_API_KEY=<your Anthropic API key from console.anthropic.com>
# CORS_ORIGIN=https://your-frontend.vercel.app
#
# Optional:
# REDIS_URL=<Upstash Redis URL if using caching>
# GITHUB_CLIENT_ID=<for GitHub OAuth>
# GITHUB_CLIENT_SECRET=<for GitHub OAuth>
